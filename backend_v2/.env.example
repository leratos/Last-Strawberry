LS_OPENROUTER_API_KEY=replace_me
# Optional keyring fallback settings (used if LS_OPENROUTER_API_KEY is empty):
# LS_OPENROUTER_KEYRING_SERVICE=OPENROUTER_API_KEY
# LS_OPENROUTER_KEYRING_USERNAME=default
LS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LS_OPENROUTER_SITE_URL=http://localhost:8002
LS_OPENROUTER_SITE_NAME=last-strawberry-v2
LS_ANALYSIS_MODEL=meta-llama/llama-3.3-70b-instruct
LS_NARRATIVE_MODEL=meta-llama/llama-3.3-70b-instruct
LS_ANALYSIS_TEMPERATURE=0.1
LS_NARRATIVE_TEMPERATURE=0.7
LS_ANALYSIS_MAX_TOKENS=700
LS_NARRATIVE_MAX_TOKENS=1200
LS_REQUEST_TIMEOUT_SECONDS=45
LS_ENVIRONMENT=development
