LS_OPENROUTER_API_KEY=replace_me
# Optional keyring fallback settings (used if LS_OPENROUTER_API_KEY is empty):
# LS_OPENROUTER_KEYRING_SERVICE=OPENROUTER_API_KEY
# LS_OPENROUTER_KEYRING_USERNAME=default
LS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LS_OPENROUTER_SITE_URL=http://localhost:8002
LS_OPENROUTER_SITE_NAME=last-strawberry-v2
LS_ANALYSIS_MODEL=meta-llama/llama-3.3-70b-instruct
LS_NARRATIVE_MODEL=meta-llama/llama-3.3-70b-instruct
LS_ANALYSIS_TEMPERATURE=0.1
LS_NARRATIVE_TEMPERATURE=0.7
LS_ANALYSIS_MAX_TOKENS=700
LS_NARRATIVE_MAX_TOKENS=1200
LS_REQUEST_TIMEOUT_SECONDS=45
LS_DATABASE_URL=sqlite:///backend_v2/data/last_strawberry_v2.db
LS_DATABASE_AUTO_INIT=true
LS_JWT_SECRET=change-me-in-production-please-use-32-plus-chars
LS_JWT_ALGORITHM=HS256
LS_JWT_EXPIRE_MINUTES=120
LS_MEMORY_CONTEXT_LIMIT=5
LS_MEMORY_MIN_IMPORTANCE=0.6
LS_MEMORY_RETRIEVAL_STRATEGY=hybrid
LS_EMBEDDINGS_PROVIDER=hash
LS_EMBEDDINGS_DIMENSIONS=64
LS_EMBEDDINGS_MODEL=openai/text-embedding-3-small
LS_EMBEDDINGS_TIMEOUT_SECONDS=20
LS_RETRIEVAL_VECTOR_WEIGHT=1.2
LS_RETRIEVAL_SEMANTIC_MIN_SIMILARITY=0.2
LS_TURN_RATE_LIMIT_ENABLED=true
LS_TURN_RATE_LIMIT_REQUESTS=20
LS_TURN_RATE_LIMIT_WINDOW_SECONDS=60
# Optional: if set, /v2/metrics/prometheus requires this header key and does not require Bearer auth.
# LS_METRICS_API_KEY=change-me
# LS_METRICS_API_KEY_HEADER=X-Metrics-Key
LS_ENVIRONMENT=development
